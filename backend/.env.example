# Server
PORT=3000
SERVER_URL=http://127.0.0.1:3000
NODE_ENV=production

# Security (required when exposed to a network)
API_KEY=change-me-to-a-long-random-string
WORKER_TOKEN=change-me-worker-token

# Restrict /api/internal/worker-config to localhost (recommended)
BIND_INTERNAL_TO_LOCALHOST=true

# Optional CORS (comma-separated origin or single URL)
# CORS_ORIGIN=https://your-dashboard.example.com

# MediaMTX
MEDIAMTX_CONFIG_PATH=/path/to/mediamtx.yml
MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889
MEDIAMTX_WEBRTC_PUBLIC_URL=http://YOUR_PUBLIC_IP:8889
MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554

# Python worker tuning
FRAME_INTERVAL_SEC=0.12
MAX_FACES_PER_FRAME=12
DEDUP_WINDOW_SEC=1.5
DEDUP_IOU=0.4
YUNET_CONF_THRESHOLD=0.45
YUNET_DETECT_MAX_WIDTH=960

# Limits
MAX_JSON_MB=20
MAX_DETECTIONS_PER_BATCH=20
MAX_SNAPSHOT_BYTES=2000000
