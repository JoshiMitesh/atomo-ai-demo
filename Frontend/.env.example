# Board (Khadas / Electron) — final Backend/ runs here
BOARD_IP=192.168.1.38
VISION_API_URL=http://192.168.1.38:3001

# Backend/src/routes/auth.js credentials
VISION_API_USERNAME=admin
VISION_API_PASSWORD=

# MediaMTX streams on board
MEDIAMTX_HLS_URL=http://192.168.1.38:8888
MEDIAMTX_WHEP_URL=http://192.168.1.38:8889
MEDIAMTX_RTSP_PORT=8554

# Backend owns MediaMTX. Set to 1 only when a separate local preview proxy is
# deliberately required as an offline fallback.
FRONTEND_LOCAL_MEDIAMTX=0

# Dashboard frontend (this PC)
PORT=3000
HOST=0.0.0.0
